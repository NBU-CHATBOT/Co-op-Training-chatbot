function answer(question){

let reply="";

if(question=="تعريف التدريب التعاوني"){
reply="التدريب التعاوني هو برنامج تدريبي يهدف إلى تأهيل الطلاب عمليًا قبل التخرج من خلال تطبيق المعرفة النظرية في بيئة العمل واكتساب المهارات المهنية اللازمة لسوق العمل.";
}

else if(question=="أهمية التدريب التعاوني"){
reply="يساعد التدريب التعاوني على: ربط الدراسة النظرية بالتطبيق العملي، تطوير مهارات الطلاب المهنية والشخصية، إعداد الطلاب لسوق العمل، اكتساب خبرة عملية قبل التخرج.";
}

else if(question=="أهداف التدريب التعاوني"){
reply="من أهم أهداف التدريب: تنمية المهارات العملية لدى الطلاب، تعزيز المعرفة التخصصية والتطبيق العملي، تدريب الطلاب على تحمل المسؤولية والالتزام، تطوير مهارات التواصل والعمل الجماعي، إكساب الطلاب مهارات التخطيط والتنفيذ، استخدام التقنيات الحديثة في العمل، تعزيز التعاون بين الجامعة وسوق العمل.";
}

else if(question=="جهة التدريب"){
reply="مؤسسة حكومية أو خاصة معتمدة يتم فيها تدريب الطالب بما يتناسب مع تخصصه.";
}

else if(question=="المتدرب"){
reply="هو الطالب الذي استوفى شروط التدريب وتم قبوله في البرنامج.";
}

else if(question=="المشرف الميداني"){
reply="موظف من جهة التدريب يشرف على الطالب أثناء التدريب.";
}

else if(question=="المشرف الأكاديمي"){
reply="عضو هيئة تدريس من الجامعة يتابع الطالب ويقيم أدائه خلال فترة التدريب.";
}

else if(question=="خطة التدريب"){
reply="برنامج يتم الاتفاق عليه بين الجامعة وجهة التدريب يحدد مهام الطالب التدريبية والمهارات التي يجب اكتسابها.";
}

else if(question=="مدة التدريب التعاوني"){
reply="بالعادة 8 أسابيع تقريبًا بما يعادل 240 ساعة تدريبية.";
}

else if(question=="مراحل التدريب التعاوني"){
reply="يمر التدريب بثلاث مراحل: مرحلة الإعداد، مرحلة تنفيذ التدريب، مرحلة التقييم.";
}

else if(question=="مرحلة الاعداد"){
reply="تشمل: تحديد الطلاب المؤهلين للتدريب، توفير جهات التدريب المناسبة، عقد لقاءات تعريفية للطلاب، تحديد المشرفين الأكاديميين.";
}

else if(question=="مرحلة تنفيذ التدريب"){
reply="تشمل: بدء الطالب التدريب في جهة التدريب، متابعة الطالب من قبل المشرف الميداني، متابعة الطالب من قبل المشرف الأكاديمي، تقديم تقارير دورية عن التدريب.";
}

else if(question=="مرحلة التقييم"){
reply="بعد انتهاء التدريب يتم: تسليم تقارير التدريب، تقييم أداء الطالب، مناقشة تقرير التدريب، رصد الدرجات النهائية.";
}

else if(question=="مهام مكتب التدريب التعاوني"){
reply="من أهم مهامه: توزيع الطلاب على جهات التدريب، توفير فرص تدريب مناسبة، التنسيق بين الأقسام وجهات التدريب، متابعة تنفيذ التدريب، جمع تقارير التقييم، تطوير برنامج التدريب التعاوني.";
}

else if(question=="مهام جهة التدريب"){
reply="تشمل: تعريف الطالب ببيئة العمل، تدريب الطالب على المهام المهنية، متابعة أداء الطالب، تسجيل الحضور والانصراف، تقييم أداء الطالب، التواصل مع المشرف الأكاديمي.";
}

else if(question=="شروط الالتحاق بالتدريب"){
reply="من أهم الشروط: أن يكون الطالب منتظمًا أكاديميًا، أن يكون متفرغًا للتدريب خلال فترة التدريب، اجتياز عدد معين من الساعات الدراسية، الالتزام بأنظمة التدريب.";
}

else if(question=="مسؤوليات الطالب المتدرب"){
reply="يجب على الطالب: الالتزام بالحضور في مواعيد التدريب، اتباع أنظمة جهة التدريب، حضور الاجتماعات واللقاءات التدريبية، تقديم التقارير المطلوبة، الاستفادة من توجيهات المشرفين، تقديم عرض عن تجربة التدريب بعد الانتهاء.";
}

else if(question=="تقييم التدريب التعاوني"){
reply="يتم تقييم الطالب بناءً على: تقييم جهة التدريب، تقييم المشرف الأكاديمي، تقرير التدريب النهائي، عرض ومناقشة التقرير. المجموع النهائي عادة 100 درجة.";
}

else if(question=="تقرير التدريب التعاوني"){
reply="يجب أن يحتوي التقرير على: صفحة الغلاف، الشكر والتقدير، جدول المحتويات، مقدمة عن جهة التدريب، وصف المهام التي قام بها الطالب، المهارات المكتسبة، النتائج والتوصيات. ويجب أن يكون منظمًا وواضحًا ومكتوبًا باللغة الإنجليزية ولا يقل عن 10 صفحات تقريبًا.";
}

else{
reply="آسف، لا أستطيع تقديم المعلومات المطلوبة.";
}

return reply;
}

function showAnswer(question){
let response = answer(question);
document.getElementById("chatbox").innerHTML += "<div class='bot-message'>" + response + "</div>";
}